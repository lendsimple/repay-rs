OperationDef {
    id: "CardTransactions_ProcessSaleAsync",
    resource: "card_transactions",
    method: "sale",
    http_method: "POST",
    path: "/transactions/card/sale",
    path_params: [],
    query: [],
    body: Json(
        Named(
            "CardSaleRequest",
        ),
    ),
    merchant: None,
    response: Some(
        Named(
            "TransactionDetailCardResponse",
        ),
    ),
    export: false,
    deprecated: false,
    doc: Some(
        "Process a card sale transaction.\n\nProcesses a combined authorization and capture in a single step. Supports 3-D Secure\nauthentication data. Reseller users must provide the MerchantId header. Supports auto-reversal\nretry for debit cards. Returns HTTP 200 if approved or HTTP 201 otherwise.",
    ),
}
OperationDef {
    id: "CardTransactions_ProcessCapture",
    resource: "card_transactions",
    method: "capture",
    http_method: "POST",
    path: "/transactions/card/{transaction_id}/capture",
    path_params: [
        Param {
            field: "transaction_id",
            wire: "transaction_id",
            ty: Named(
                "TransactionId",
            ),
            doc: Some(
                "The TRX_HD_Key of the authorized transaction to\ncapture.",
            ),
        },
    ],
    query: [],
    body: Json(
        Named(
            "CardCaptureRequest",
        ),
    ),
    merchant: Optional,
    response: Some(
        Named(
            "TransactionDetailCardResponse",
        ),
    ),
    export: false,
    deprecated: false,
    doc: Some(
        "Capture a previously authorized card transaction.\n\nCompletes a previously authorized transaction by capturing the funds. Supports optional\namount override. Reseller users must provide the MerchantId header. Returns HTTP 200 if\napproved or HTTP 201 otherwise.",
    ),
}
OperationDef {
    id: "DigitalWallet_GetMerchant",
    resource: "digital_wallet",
    method: "get_merchant",
    http_method: "GET",
    path: "/digitalwallet/merchants/{request.wallet_merchant_id}",
    path_params: [
        Param {
            field: "wallet_merchant_id",
            wire: "request.wallet_merchant_id",
            ty: String,
            doc: None,
        },
    ],
    query: [
        QueryParam {
            field: "use_test_keys",
            wire: "request.use_test_keys",
            ty: Bool,
            multi: false,
            doc: Some(
                "A value indicating whether to use test keys for the digital wallet URI request.",
            ),
        },
    ],
    body: None,
    merchant: None,
    response: Some(
        Named(
            "DigitalWalletMerchantDetailsResponse",
        ),
    ),
    export: false,
    deprecated: false,
    doc: Some(
        "Get digital wallet merchant details.\n\nRetrieves digital wallet merchant details by wallet merchant ID. Restricted to reseller users;\nreturns HTTP 403 for non-reseller users. Maps the `DigitalWalletUriRequest` to a\nMerchant model (with correlation ID) and delegates to\nIMerchantRegistration.GetMerchantAsync. The result is mapped to a\n`DigitalWalletMerchantDetailsResponse` containing the wallet merchant ID and\nServices (ApplePay enabled flag, domain names). After retrieval, checks if the merchant\nwas not found (ApplePay not enabled and no domain names configured), throwing\nItemNotFoundException in that case.",
    ),
}
