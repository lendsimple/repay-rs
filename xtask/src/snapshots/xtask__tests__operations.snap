OperationDef {
    id: "CardSettlementBatchClosing_CloseCardSettlementBatch",
    resource: "batches",
    method: "close_card",
    http_method: "POST",
    path: "/openbatches/card",
    path_params: [],
    query: [],
    body: Json(
        Named(
            "CloseCardSettlementBatchRequest",
        ),
    ),
    merchant: Required,
    response: Some(
        Named(
            "CloseCardSettlementBatchResponse",
        ),
    ),
    export: false,
    deprecated: false,
    doc: Some(
        "Queue a card settlement batch for closing.\n\nQueues a card settlement batch for closing. Supports two modes depending on the request:\n\n- By batch ID — when request.BatchId is provided, calls\nQueueClosingBatchByBatchIdAsync which validates the batch ID range, fetches the batch,\nverifies the batch belongs to the authenticated merchant, validates the batch status is \"Open\"\nvia FluentValidation, updates the status to \"Queued\", and raises a batch closing event.\n- Single batch — when request.BatchId is null, calls\nQueueClosingSingleBatchAsync which validates the merchant's feature flag enablement,\nresolves the single processor profile for the merchant, fetches the single open batch for that\nprocessor profile, validates and queues it for closing.\n\nOn success, returns HTTP 202 Accepted with a `CloseCardSettlementBatchResponse`\ncontaining the batch ID and a correlation ID (from the CloudFront request header). On validation\nfailure, the FluentValidation.Results.ValidationResult errors are added to the\nModelState and a non-success response is returned.",
    ),
}
OperationDef {
    id: "Adjustments_ProcessBulkDisbursementFundingAdjustment",
    resource: "adjustments",
    method: "bulk_disbursement_funding",
    http_method: "POST",
    path: "/adjustments/disbursementfunding/bulk",
    path_params: [],
    query: [],
    body: Multipart,
    merchant: None,
    response: Some(
        Json,
    ),
    export: false,
    deprecated: false,
    doc: Some(
        "Process bulk disbursement funding adjustments from a CSV file.\n\nProcesses bulk disbursement funding adjustments from a CSV file uploaded as multipart form data.\nThe CSV must contain columns: MerchantId, TransactionId, OriginalAmount, AdjustmentAmount (header row is optional).\nOnly one file is allowed per request. Each row is validated for sanity (positive amounts, adjustment <= original)\nand for duplicates. If all rows pass sanity checks, the engine validates each transaction (exists, correct type,\nmatching merchant, not fully reversed, remaining balance sufficient) before processing.\nReturns a `BulkTransactionProcessingResult` on full success, or a CSV file with per-row results\n(including error messages) on partial or full failure.",
    ),
}
