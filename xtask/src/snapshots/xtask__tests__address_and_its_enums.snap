            facets: Facets {
                min_length: None,
                max_length: Some(
                    50,
                ),
                min: None,
                max: None,
                rule: None,
            },
            sensitive: false,
        },
        Field {
            name: "state",
            ty: Named(
                "State",
            ),
            required: false,
            doc: Some(
                "The state or province code.",
            ),
            facets: Facets {
                min_length: None,
                max_length: None,
                min: None,
                max: None,
                rule: None,
            },
            sensitive: false,
        },
        Field {
            name: "zip",
            ty: String,
            required: false,
            doc: Some(
                "The postal or ZIP code.",
            ),
            facets: Facets {
                min_length: None,
                max_length: Some(
                    30,
                ),
                min: None,
                max: None,
                rule: None,
            },
            sensitive: false,
        },
        Field {
            name: "country_code",
            ty: Named(
                "CountryCode",
            ),
            required: false,
            doc: Some(
                "The country code.",
            ),
            facets: Facets {
                min_length: None,
                max_length: None,
                min: None,
                max: None,
                rule: None,
            },
            sensitive: false,
        },
    ],
}
