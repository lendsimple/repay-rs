StructDef {
    name: "Address",
    origin: "Address",
    role: Request,
    doc: Some(
        "Represents a physical or mailing address, including street, city, state, zip code, and country information.",
    ),
    fields: [
        Field {
            name: "street",
            ty: String,
            required: false,
            doc: Some(
                "The primary street address.",
